{
  "pollInterval": "1m",
  "providers": [
    {
      "name": "primary-udr",
      "type": "udr",
      "user": "reseller-user",
      "password": "replace-me",
      "domains": [
        {
          "name": "example.com",
          "subdomains": [
            "home.example.com",
            "vpn.example.com"
          ]
        }
      ]
    },
    {
      "name": "secondary-ddns",
      "type": "dyndns2",
      "updateUrl": "https://provider.example/nic/update",
      "user": "account-name",
      "password": "replace-me",
      "addressFamily": "both",
      "hostnames": [
        "home.example.net",
        "vpn.example.net"
      ]
    }
  ]
}
